# zova build-time configuration — copy to `.env` and fill in your values.
#
# Flutter reads this file with: flutter run --dart-define-from-file=.env
# (or `flutter build <target> --dart-define-from-file=.env`).
# `.env` is git-ignored: never commit real keys.

# --- AI tutor (Gemini by default) --------------------------------------------
# Google Gemini API key from https://aistudio.google.com/app/apikey
# (new "AQ." auth keys and classic "AIza" keys both work).
ZOVA_AI_API_KEY=

# Provider: `gemini` (default) or `openai` (any OpenAI-compatible
# /chat/completions endpoint). When empty, the key prefix decides.
#ZOVA_AI_PROVIDER=gemini

# Optional overrides (defaults: Gemini 2.0 Flash / OpenAI gpt-4o-mini).
#ZOVA_AI_MODEL=gemini-2.0-flash
#ZOVA_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Optional remote backends -------------------------------------------------
#ZOVA_SUPABASE_URL=
#ZOVA_SUPABASE_ANON_KEY=
#ZOVA_STRIPE_PUBLISHABLE_KEY=
#ZOVA_STRIPE_SESSION_FUNCTION_URL=
#ZOVA_TRANSLATION_ENDPOINT=
#ZOVA_TRANSLATION_API_KEY=
